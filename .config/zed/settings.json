{
  "disable_ai": true,
  "edit_predictions": {
    "provider": "zed"
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-4.1"
    },
  },
  "icon_theme": "Zed (Default)",
  "theme": "Tokyo Night",
  "vim_mode": true,
  "ui_font_family": "FiraCode Nerd Font",
  // "ui_font_family": "Terminess Nerd Font",
  "ui_font_size": 14,
  "cursor_blink": false,
  "relative_line_numbers": "enabled",
  "scrollbar": {
    "show": "never"
  },
  "buffer_font_family": "FiraCode Nerd Font",
  // "buffer_font_family": "Terminess Nerd Font",
  "buffer_font_size": 14,
  "buffer_line_height": {
    "custom": 1.3
  },
  "terminal": {
    "font_size": 14,
    "font_family": "FiraCode Nerd Font",
    "line_height": {
      "custom": 1.1
    }
  },
  "lsp": {
    "gopls": {
      "initialization_options": {
        "gofumpt": true,
        "usePlaceholders": true,
        "staticcheck": true,
        "codelenses": {
          "gc_details": true,
          "generate": true,
          "test": true,
          "tidy": true,
          "upgrade_dependency": true,
          "vendor": true
        },
        "hints": {
          "assignVariableType": true,
          "compositeLiteralFields": true,
          "compositeliteralTypes": true,
          "constantValue": true,
          "functionTypeParameters": true,
          "parameterName": true,
          "rangeVariableTypes": true
        }
      }
    }
  }
}
